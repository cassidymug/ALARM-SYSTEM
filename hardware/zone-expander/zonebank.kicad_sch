  (hierarchical_label "ZONE_ADC[1..8]" (shape output) (at 220 50 0) (fields_autoplaced)
    (effects (font (size 1.27 1.27)) (justify left))
    (uuid hl-zone-adc-bus)
  )

  (text "Zone Front-End Design (per channel):\n\nZONE+ terminal → 10kΩ pull-up to +3.3V → ADC input\n                    ↓\n                  TVS diode to GND (5.6V bidirectional)\n                    ↓\n                  ZONE− terminal (GND)\n\nSensor loop: ZONE+ → contact → 4.7kΩ EOL resistor → ZONE−\n\nADC voltage states:\n- Normal (loop closed, 4.7kΩ): ~1.55V (divider: 4.7kΩ / (10kΩ + 4.7kΩ) × 3.3V)\n- Alarm (loop short, 0Ω): ~0V\n- Open/Tamper (loop open, ∞Ω): ~3.3V (full pull-up)\n- Fault: Intermediate voltage indicates wrong/damaged EOL\n\nThis bank implements 8 identical channels.\nReplicate this sheet 4 times for 32 total zones."
    (at 20 200 0)
    (effects (font (size 1.27 1.27)) (justify left))
    (uuid "text-zone-notes")
  )

