[Unit]
Description=Guardian Sensors - Zone I/O management
Documentation=https://github.com/guardian-dvr/guardian
After=network.target
PartOf=guardian.target
Before=guardian-alarm.service

[Service]
Type=simple
ExecStart=/usr/bin/guardian-sensors
Restart=on-failure
RestartSec=5s
User=guardian-sensors
Group=guardian
SupplementaryGroups=dialout gpio

# Security hardening (needs device access)
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=no
NoNewPrivileges=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

CapabilityBoundingSet=
AmbientCapabilities=

ConfigurationDirectory=guardian
StateDirectory=guardian
LogsDirectory=guardian

[Install]
WantedBy=guardian.target
